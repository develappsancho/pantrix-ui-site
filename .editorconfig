root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_standard_class-signature = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_parameter-list-wrapping = disabled
# A @Composable function is PascalCase by Compose's own convention.
ktlint_function_naming_ignore_when_annotated_with = Composable, Preview
# Two rules of ktlint_official that disagree with how Compose is written, by Google, JetBrains and the IDE: a modifier
# chain starts on the line of its `=`, and its last link is not glued onto a closing brace.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_ignore_back_ticked_identifier = true
# No trailing commas: the IDE adds none, lintKotlin reports one and formatKotlin removes it.
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_wrap_around_constructor = false
ij_kotlin_wrap_around_function_parentheses = false
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled
ktlint_standard_function-signature = disabled
ktlint_function_signature_body_expression_wrapping = default

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
