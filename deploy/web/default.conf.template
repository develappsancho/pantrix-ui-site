# Pantrix UI's site in nginx: its files, served by the rules its pages are written for, and the site's server at
# /mcp, which only nginx reaches. docs/deploy/ARCHITECTURE_GUIDE.md says why each rule is here.
#
# A template: nginx's image writes it as conf.d/default.conf as it starts, with SITE_URL, the address the stack is
# served at, SITE_HOST, its host, and SITE_HSTS, the Strict-Transport-Security it is served with, which
# 05-site-address.envsh gives.

# How long a browser keeps a file. A file named by a hash of what it holds never changes, since a new build gives it a
# new name: it is kept for a year. Any other file is asked for again each time, and answered "not modified" while it
# is the same, so a new build is seen at once.
map $uri $site_cache {
    "~^/[0-9a-f]{16,}\.wasm$" "public, max-age=31536000, immutable";
    default                   "no-cache";
}

# The site's host under www is the same site under a second name: it is sent, for good, to the one its pages give.
server {
    listen 80;
    server_name www.${SITE_HOST};
    add_header Strict-Transport-Security "${SITE_HSTS}" always;
    return 301 ${SITE_URL}$request_uri;
}

server {
    listen 80 default_server;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    charset utf-8;

    # Every file worth it was compressed when the image was made: nginx sends the .gz beside it to a browser that
    # takes gzip, and compresses nothing itself.
    gzip_static on;
    gzip_vary on;

    add_header Cache-Control $site_cache always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;
    # Over HTTPS alone, for a while: empty over plain HTTP, and an empty header is not sent.
    add_header Strict-Transport-Security "${SITE_HSTS}" always;
    # What a page may load and run, reported and not yet enforced. Its scripts: the site's own, its WebAssembly, and
    # the one script written into every page, by its hash, which check.sh holds to the pages'. Its styles: the site's
    # own, and the one Compose writes into its canvas's shadow root as the app starts, which changes with Compose and
    # is not held by a hash. What it fetches: the site's files and GitHub's API, which the download page reads the
    # desktop app's release from. Google's fonts are not among them: the site's typeface carries fallbacks for the
    # characters its fonts lack, so Compose fetches no Noto font from there. A browser writes what breaks it in its
    # console.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-TFCAy9jup0JF+XnX2hWWDY2D8Q+Wi+UnpkcA3EzGXwM='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;

    # A file as it is; an address with a page, its folder's index.html, with no redirect; any other address, 404.html
    # with a 404.
    location / {
        try_files $uri $uri/index.html =404;
    }
    error_page 404 /404.html;

    # Pantrix UI's MCP server, which the site's server answers.
    location = /mcp {
        # The server's name is looked up at each request, through Docker's own DNS, so that nginx starts, and the site
        # is served, while the server is not up yet.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $site_server http://server:8080;
        proxy_pass $site_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # An answer sent as a stream of events goes out as it comes.
        proxy_buffering off;
        # The server takes a message of 64 KB at most, and answers within 30 seconds.
        client_max_body_size 64k;
        proxy_read_timeout 60s;
    }
}
